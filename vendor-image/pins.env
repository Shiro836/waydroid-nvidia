# Waydroid vendor image from source: one block per Android branch (A13 = lineage-20 first; A14/A15 later).
# Read by vendor-image/build-vendor.sh and .github/workflows/vendor-image.yml.
#
# lineage-20 / Android 13: reproduce the official 20260927 MAINLINE vendor image.
# Manifest = the builder tree's merged manifest (LineageOS android 0f52348 + Waydroid local manifests) with every
# branch-tracked project pinned to its last first-parent commit at or before the official build's
# ro.vendor.build.date.utc (1790542319 = 2026-09-27T20:51:59Z), plus the 6 projects LineageOS's manifest 0d12a65
# (2026-09-23) moved from AOSP tags to LineageOS forks. Generated by project-delta.sh + cutoff-shas.sh +
# pin-manifest.py (see notes.md).
L20_MANIFEST=vendor-image/manifests/lineage-20-waydroid-20260927.xml
L20_LUNCH=lineage_waydroid_x86_64-userdebug
L20_PRODUCT=waydroid_x86_64
L20_CUTOFF=2026-09-27T20:51:59Z
# official reference image (same values as hwcomposer/pins.env IMG_VENDOR_*)
L20_REF_VENDOR_URL=https://sourceforge.net/projects/waydroid/files/images/vendor/waydroid_x86_64/lineage-20.0-20260927-MAINLINE-waydroid_x86_64-vendor.zip/download
L20_REF_VENDOR_SHA256=d911b8353f6c807b94790b1c41c67e863a9f3dcd1cf3ec0232351398235afd7a
L20_REF_VENDOR_URL_ALT=https://downloads.sourceforge.net/project/waydroid/images/vendor/waydroid_x86_64/lineage-20.0-20260927-MAINLINE-waydroid_x86_64-vendor.zip
# nvidia-prolapse product on the same tree (vendor-image/product, patches/): Waydroid's product + our vendor modules
L20_PROLAPSE_LUNCH=lineage_nvidia_waydroid_x86_64-userdebug
L20_PROLAPSE_DEVICE=waydroid_nvidia_x86_64
# The driver (NVK over the Rust RM backend, nvrm, Vulkan HAL, gralloc, Codec2, bionic libdrm), built from source:
# github.com/Shiro836/nvidia-prolapse at this commit (tools/driver_source.py fetches and verifies it into
# build/nvidia-prolapse-src; packaging/native/build-native.sh --driver-src builds a local checkout instead).
NVIDIA_PROLAPSE_REF="main fbd4e768e3ffebc1ceb2c0e7fe68b8c02514d49e"
