From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nvidia-prolapse <nvidia-prolapse@localhost>
Date: Fri, 16 Oct 2026 19:55:46 +0300
Subject: [PATCH 4/5] gbm_mesa: P010 and a GPU-writable NV12/P010 layout for
 decoder output

Applies to https://github.com/waydroid/android_external_minigbm
16844babfbd83d7c206ca22256257cbf26ca7de1 ("gralloc: Handle PixelFormat::R_8"),
after 0001..0003.

Hardware video decoders (the nvidia-prolapse Codec2 decoder) allocate their output
blocks as HAL_PIXEL_FORMAT_YCbCr_420_888 (-> NV12) and, for 10-bit streams,
HAL_PIXEL_FORMAT_YCBCR_P010 (-> DRM P010), and the NVIDIA copy engine writes the
decoded picture into them (nv_video_copy_out, LINEAR target).

1. gbm_mesa_driver_init() registers no P010 combination, so every P010
   allocation fails with "Unsupported combination". Register it like NV12
   (texture, scanout, HW video decoder).
2. A format the wrapper does not allocate itself (NV12, P010) is laid out by
   drv_bo_from_format() on minigbm's R8 carrier with stride = width in pixels.
   For P010 that is half the real row size (2 bytes per sample), and for NV12
   it leaves odd pitches (854x480 -> 854). Use the format's byte stride,
   aligned to 256 (the NVIDIA driver's own LINEAR copy pitch, observed in its
   cross-GPU present path), and an even luma height so the CbCr plane starts on
   a whole chroma row. Strides/offsets still come from bo->meta, so every
   mapper/lock user reads the new layout.

3. Importers bind the carrier as a two-plane LINEAR image with these
   offsets/pitches, and a driver may bind each plane like a plane of a
   DISJOINT image, with that plane's own alignment and size. NVIDIA's driver
   (615, measured) does: pitch * rows rounded up to 64 KiB, 64 KiB alignment;
   a CbCr offset off a page makes RM reject the plane's mapping
   ("intermapRegisterDmaMapping: Failed to insert new mapping node") and the
   plane samples zeros without a Vulkan error, and the image requires more
   memory than the packed layout (854x480 NV12: 786432 B, packed 737280 B;
   an undersized import fails VK_ERROR_OUT_OF_DEVICE_MEMORY). New optional
   wrapper ABI (gbm_mesa_wrapper_layout.h): get_gbm_layout_ops()->
   plane_layout() moves the plane offsets to the wrapper's driver per-plane
   requirements and returns the buffer size; minigbm uses both. NVK's rule
   (32-byte alignment, exact sizes) leaves the packed layout unchanged.
   NV12/P010 allocation fails loudly with a wrapper that lacks the ABI.
---
 gbm_mesa_driver/gbm_mesa_internals.cpp    | 60 ++++++++++++++++++++++-
 gbm_mesa_driver/gbm_mesa_wrapper_layout.h | 46 +++++++++++++++++
 2 files changed, 105 insertions(+), 1 deletion(-)
 create mode 100644 gbm_mesa_driver/gbm_mesa_wrapper_layout.h

diff --git a/gbm_mesa_driver/gbm_mesa_internals.cpp b/gbm_mesa_driver/gbm_mesa_internals.cpp
index 11643f0..72db98c 100644
--- a/gbm_mesa_driver/gbm_mesa_internals.cpp
+++ b/gbm_mesa_driver/gbm_mesa_internals.cpp
@@ -23,6 +23,7 @@ extern "C" {
 #include "../drv.h"
 #include "gbm_mesa_wrapper.h"
 #include "gbm_mesa_wrapper_map_flags.h"
+#include "gbm_mesa_wrapper_layout.h"
 
 #include "UniqueFd.h"
 #include "drv_priv.h"
@@ -123,6 +124,11 @@ int gbm_mesa_driver_init(struct driver *drv)
 				   BO_USE_CAMERA_READ | BO_USE_CAMERA_WRITE);
 	drv_modify_combination(drv, DRM_FORMAT_NV21, &linear_metadata, BO_USE_HW_VIDEO_ENCODER);
 
+	/* HAL_PIXEL_FORMAT_YCBCR_P010: 10-bit hardware decoder output (VP9 profile 2, HEVC Main10,
+	 * AV1 10-bit), sampled by the GPU like NV12. */
+	drv_add_combination(drv, DRM_FORMAT_P010, &linear_metadata,
+			    BO_USE_TEXTURE_MASK | BO_USE_SCANOUT | BO_USE_HW_VIDEO_DECODER);
+
 	/*
 	 * R8 format is used for Android's HAL_PIXEL_FORMAT_BLOB and is used for JPEG snapshots
 	 * from camera and input/output from hardware decoder/encoder.
@@ -154,6 +160,8 @@ struct GbmMesaDriver {
 	struct gbm_ops *wrapper = nullptr;
 	/* optional: map/unmap with the lock's access flags (gbm_mesa_wrapper_map_flags.h) */
 	const struct gbm_map_flags_ops *map_flags_ops = nullptr;
+	/* optional: the driver's memory requirement of a NV12/P010 layout (gbm_mesa_wrapper_layout.h) */
+	const struct gbm_layout_ops *layout_ops = nullptr;
 	struct gbm_device *gbm_dev = nullptr;
 	void *dl_handle = nullptr;
 
@@ -283,6 +291,19 @@ static std::shared_ptr<GbmMesaDriver> gbm_mesa_get_or_init_driver(struct driver
 			gbm_mesa_drv->map_flags_ops = mf;
 		}
 
+		auto get_layout_ops = (const struct gbm_layout_ops *(*)(void))dlsym(
+		    gbm_mesa_drv->dl_handle, GBM_GET_LAYOUT_OPS_SYMBOL);
+		if (get_layout_ops) {
+			auto lo = get_layout_ops();
+			if (!lo || lo->version != GBM_LAYOUT_OPS_VERSION || !lo->plane_layout) {
+				drv_loge("'%s' exports '%s' but its ops are unusable (version %u, want %u)",
+					 GBM_WRAPPER_NAME, GBM_GET_LAYOUT_OPS_SYMBOL,
+					 lo ? lo->version : 0u, GBM_LAYOUT_OPS_VERSION);
+				return nullptr;
+			}
+			gbm_mesa_drv->layout_ops = lo;
+		}
+
 		gbm_mesa_drv->gbm_dev =
 		    gbm_mesa_drv->wrapper->dev_create(gbm_mesa_drv->gbm_node_fd.Get());
 		if (!gbm_mesa_drv->gbm_dev) {
@@ -384,8 +405,45 @@ int gbm_mesa_bo_create(struct bo *bo, uint32_t width, uint32_t height, uint32_t
 
 	if (alloc_args.drm_format == 0) {
 		/* Always use linear for spoofed format allocations. */
-		drv_bo_from_format(bo, alloc_args.width, alloc_args.height, format);
+		uint32_t spoof_stride = alloc_args.width;
+		uint32_t spoof_height = alloc_args.height;
+		if (format == DRM_FORMAT_NV12 || format == DRM_FORMAT_P010) {
+			/*
+			 * Bi-planar YUV is written by the GPU copy engine (hardware decoder output)
+			 * and sampled through Vulkan/EGL imports: rows in bytes (P010 is 2 bytes per
+			 * sample, the width alone would be half its pitch), pitch aligned to 256 bytes
+			 * (the NVIDIA driver's own LINEAR copy pitch), even luma height so the CbCr
+			 * plane starts on a whole chroma row.
+			 */
+			spoof_stride = ALIGN(drv_stride_from_format(format, alloc_args.width, 0), 256);
+			spoof_height = ALIGN(alloc_args.height, 2);
+		}
+		drv_bo_from_format(bo, spoof_stride, spoof_height, format);
 		bo_layout_ready = true;
+		if (format == DRM_FORMAT_NV12 || format == DRM_FORMAT_P010) {
+			/*
+			 * Importers bind the carrier as a two-plane LINEAR image with these
+			 * offsets/pitches. A driver can bind each plane like a DISJOINT image's
+			 * plane, with its own alignment and size (NVIDIA: 64 KiB): the wrapper
+			 * moves the planes there and sizes the buffer (gbm_mesa_wrapper_layout.h).
+			 */
+			if (!drv->layout_ops) {
+				drv_loge("%ux%u format 0x%08x: '%s' does not export '%s'; the planes "
+					 "cannot be placed for its driver",
+					 width, height, format, GBM_WRAPPER_NAME, GBM_GET_LAYOUT_OPS_SYMBOL);
+				return -EINVAL;
+			}
+			uint64_t need = 0;
+			err = drv->layout_ops->plane_layout(drv->gbm_dev, format, width, height,
+							    (uint32_t)bo->meta.num_planes,
+							    bo->meta.strides, bo->meta.offsets, &need);
+			if (err) {
+				drv_loge("%ux%u format 0x%08x: the wrapper cannot lay out the planes (%d)",
+					 width, height, format, err);
+				return err;
+			}
+			bo->meta.total_size = need;
+		}
 		bo->meta.total_size = ALIGN(bo->meta.total_size, size_align);
 		alloc_args.drm_format = DRM_FORMAT_R8;
 		alloc_args.width = bo->meta.total_size;
diff --git a/gbm_mesa_driver/gbm_mesa_wrapper_layout.h b/gbm_mesa_driver/gbm_mesa_wrapper_layout.h
new file mode 100644
index 0000000..2456393
--- /dev/null
+++ b/gbm_mesa_driver/gbm_mesa_wrapper_layout.h
@@ -0,0 +1,46 @@
+/*
+ * Optional extension of the gbm_mesa wrapper ABI (gbm_mesa_wrapper.h): place
+ * the planes of a multi-planar LINEAR buffer where the wrapper's driver can
+ * bind them.
+ *
+ * Formats the wrapper does not allocate itself (NV12, P010) are laid out by
+ * minigbm and allocated as an R8 carrier of bo->meta.total_size. Importers
+ * bind the buffer as a multi-planar image with the explicit plane offsets and
+ * pitches of that layout. A driver can bind each plane like a plane of a
+ * DISJOINT image, with that plane's own memory requirements: NVIDIA's Vulkan
+ * driver (615) maps each plane separately, pitch * rows rounded up to 64 KiB,
+ * so a plane offset off its alignment samples zeros, and the image needs more
+ * memory than the packed layout. plane_layout() moves the offsets to the
+ * driver's per-plane requirements and reports the buffer size that holds them.
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+struct gbm_device;
+
+#define GBM_LAYOUT_OPS_VERSION 1u
+#define GBM_GET_LAYOUT_OPS_SYMBOL "get_gbm_layout_ops"
+
+struct gbm_layout_ops {
+	/* GBM_LAYOUT_OPS_VERSION of the wrapper; the glue refuses another */
+	uint32_t version;
+
+	/*
+	 * A width x height image of drm_format, LINEAR, num_planes planes in one
+	 * buffer with row pitches strides[] (bytes).
+	 * In:  offsets[] = the smallest offset of each plane the caller's layout
+	 *      allows (e.g. its packed layout).
+	 * Out: offsets[] >= the input, each a multiple of the driver's alignment
+	 *      for that plane and past the previous plane's required size;
+	 *      *total_size = the bytes the buffer needs for the image with those
+	 *      offsets (the last plane's required size, and at least the driver's
+	 *      memory requirement of the whole image).
+	 * 0 on success, else a negative errno (the wrapper logs why); the caller
+	 * must not allocate then.
+	 */
+	int (*plane_layout)(struct gbm_device *gbm, uint32_t drm_format, uint32_t width,
+			    uint32_t height, uint32_t num_planes, const uint32_t *strides,
+			    uint32_t *offsets, uint64_t *total_size);
+};
