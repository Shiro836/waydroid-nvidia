def stage_sources(rust_profile='dev'):
    sources = {}
    for sub, target, drm in (
        ('lib64', 'android', 'x86_64'),
        ('lib', 'android32', 'x86'),
    ):
        base = DRIVER / 'build/source-native-integration' / target
        vendor = f'vendor_extra/{sub}'
        sources[f'{vendor}/hw/vulkan.nvidia.so'] = base / 'vulkan.nvidia.so'
        sources[f'{vendor}/libvulkan_nouveau.so'] = DRIVER / f'build/nvk-{target}/src/nouveau/vulkan/libvulkan_nouveau.so'
        sources[f'{vendor}/libnv_bionic_native.so'] = profiles.rust_library(DRIVER, target, rust_profile)
        sources[f'{vendor}/libgbm_mesa_wrapper.so'] = base / 'libgbm_mesa_wrapper.so'
        sources[f'{vendor}/libdrm.so.2'] = DRIVER / f'build/libdrm/build-android33-{drm}/libdrm.so'
        # minigbm core built from pinned source + the driver's gralloc/minigbm/000*.patch (0004: NV12/P010 layout)
        sources[f'{vendor}/libminigbm_gralloc_gbm_mesa.so'] = DRIVER / 'gralloc/out' / target / 'libminigbm_gralloc_gbm_mesa.so'
        for name in native.EGL_ANGLE:
            rel = f'vendor/{sub}/egl/{name}'
            sources[rel] = Path('/var/lib/waydroid/nv/guest') / rel
    return sources


_GATE = []


def _release_gate():
    if not _GATE:
        _GATE.append(_load(REPO / 'packaging/native/release_gate.py', 'release_gate'))
    return _GATE[0]


def _needed(path):
    """DT_NEEDED of an ELF object, parsed from the file (release_gate.needed), not from readelf's localised text."""
    return _release_gate().needed(path)


def _proprietary_needed(path):
    """DT_NEEDED names of `path` that are not bionic: glibc, the glibc shim, NVIDIA's libraries."""
    return [n for n in _needed(path) if any(m in n for m in ('libc.so.6', 'libnvglibc', 'libEGL_nvidia', 'libnvidia-'))]


def gate_coverage(sources, rust_profile='dev'):
    """(exercised, not_exercised) manifest paths: an artifact counts as exercised when the
    runner passes it on a command line or it is a DT_NEEDED of one, resolved through that
    case's LD_LIBRARY_PATH. dlopen()ed libraries are not followed (a lower bound)."""
    runner = _load(RUNNER, 'native_vulkan_regression')
    loaded = set()
    for target in ('host', 'android', 'android32'):
        profiles.verify_metadata(DRIVER, target, rust_profile)
        if target != 'host':
            sub = 'lib64' if target == 'android' else 'lib'
            selected = profiles.rust_library(DRIVER, target, rust_profile)
            recorded = sources.get(f'vendor_extra/{sub}/libnv_bionic_native.so')
            if recorded is None or Path(recorded).resolve() != selected.resolve():
                raise RuntimeError(f'Stage/gate Rust source differs from selected {rust_profile}: {recorded}; expected {selected}')
        for _, command in runner.cases(target, 'all'):
            env, argv = runner.launch(target, command, rust_profile)
            dirs = env['LD_LIBRARY_PATH'].split(':')
            todo = [a for a in argv if a.startswith('/')]
            while todo:
                path = os.path.realpath(todo.pop())
                if path in loaded or native._elf_class(path) is None:
                    continue
                loaded.add(path)
                for name in _needed(path):
                    for directory in dirs:
                        candidate = os.path.join(directory, name)
                        if os.path.isfile(candidate):
                            todo.append(candidate)
                            break
    exercised = sorted(r for r, s in sources.items() if os.path.realpath(s) in loaded)
    return exercised, sorted(set(sources) - set(exercised))


def _runner_user():
    """Run the GPU gate as the owner of build/, never as root: the i686 cases enter a user
    namespace (unshare --user) designed for an unprivileged caller, and the logs stay owned
    by the user who rebuilds and re-runs them."""
    owner = (REPO / 'build').stat().st_uid
    if os.geteuid() != 0 or owner == 0:
        return None
    return pwd.getpwuid(owner)


def run_gate(sources, rust_profile='dev'):
    """Run the driver's tests/vulkan/run.py --run on every target and suite; return the record."""
    kernel = native.driver_version()
    exercised, not_exercised = gate_coverage(sources, rust_profile)
    stamp = time.strftime('%Y%m%d-%H%M%S')
    logs = REPO / 'build/vulkan-gate' / f'gate-{stamp}'
    cmd = [PYTHON, str(RUNNER), *RUNNER_ARGS, '--rust-profile', rust_profile, '--logs', str(logs)]
    user = _runner_user()
    env = dict(os.environ)
    if user is not None:
        cmd = ['runuser', '-u', user.pw_name, '--', *cmd]
        env.update(HOME=user.pw_dir, USER=user.pw_name, LOGNAME=user.pw_name)
    who = user.pw_name if user else pwd.getpwuid(os.geteuid()).pw_name
    print(f'Regression gate as {who}: {" ".join(cmd)}', flush=True)
    started, t0 = now(), time.monotonic()
    cases, current = [], None
    with subprocess.Popen(cmd, cwd=REPO, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                          text=True) as proc:
        for line in proc.stdout:
            print(line, end='', flush=True)
            if m := re.fullmatch(r'\[(\w+/\w+)\]', line.strip()):
                current = (m.group(1), time.monotonic())
            elif (m := re.match(r'exit=(-?\d+) log=', line)) and current:
                cases.append({'case': current[0], 'exit': int(m.group(1)),
                              'seconds': round(time.monotonic() - current[1], 2)})
                current = None
    seconds = round(time.monotonic() - t0, 1)
    if proc.returncode != 0 or not cases or any(c['exit'] for c in cases):
        raise RuntimeError(f'Regression gate FAILED (exit {proc.returncode}, {len(cases)} cases ran); '
                           f'logs in {logs}. Nothing was stamped.')
    after = native.driver_version()
    if after != kernel:
        raise RuntimeError(f'NVIDIA kernel module changed during the gate ({kernel} -> {after})')
    return {'runner': ' '.join(['<driver>/tests/vulkan/run.py', *RUNNER_ARGS, '--rust-profile', rust_profile]),
            'rust_profile': rust_profile, 'runner_sha256': sha256(RUNNER), 'user': who, 'started': started, 'finished': now(),
            'seconds': seconds, 'exit': 0, 'kernel_module': kernel, 'log_dir': str(logs),
            'cases': cases, 'exercised': exercised, 'not_exercised': not_exercised}


