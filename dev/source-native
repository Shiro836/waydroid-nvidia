    helper = SYSTEM_WAYDROID / 'tools/helpers/nvidia_native.py'
    if not helper.is_file() or sha256(helper) != sha256(REPO / 'waydroid/nvidia_native.py'):
        raise RuntimeError(f'{helper} is missing or differs from {REPO}/waydroid/nvidia_native.py: the installed '
                           'waydroid is not the one this package patched. Reinstall waydroid-nvidia (AUR '
                           'waydroid-nvidia-bin, or packaging/install.sh) so both come from one release')
    return [PYTHON, str(SYSTEM_WAYDROID / 'waydroid.py')]


def now():
    return datetime.datetime.now().astimezone().isoformat(timespec='seconds')


def sha256(path):
    digest = hashlib.sha256()
    with open(path, 'rb') as f:
        for block in iter(lambda: f.read(1 << 20), b''):
            digest.update(block)
    return digest.hexdigest()


def write_atomic(path, text):
    """tmp + fsync + rename in the target directory; readers see the old or the new file."""
    path = Path(path)
    tmp = path.with_name(f'.{path.name}.tmp-{os.getpid()}')
    with open(tmp, 'w') as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    tmp.chmod(0o644)
    os.replace(tmp, path)
    fd = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


# A checkpoint (before-source-native-*) records where the nvidia-prolapse root link pointed before the change.
LINK_TARGET = 'nvidia-prolapse.target'
LEGACY_LINK_TARGET = 'rust-driver.target'   # the same record in checkpoints taken before the mode rename


def _link_record(backup):
    """The checkpoint's link record file (current or pre-rename name), or the current name if none exists."""
    backup = Path(backup)
    legacy = backup / LEGACY_LINK_TARGET
    return legacy if not (backup / LINK_TARGET).is_file() and legacy.is_file() else backup / LINK_TARGET


def configured_root(cfg_path=CFG):
    """The nvidia-prolapse root (real path) a cfg runs: for the live cfg the resolved link
    nvidia_native.ROOT_LINKS['nvidia-prolapse']; for a checkpoint's cfg its recorded link target, or the
    path key it was saved with (checkpoints from before the link convention; read-only use)."""
    cfg = configparser.ConfigParser()
    if not cfg.read(cfg_path):
        raise RuntimeError(f'Cannot read {cfg_path}')
    root = _cfg_rust_root(cfg)
    if root:
        return Path(root).resolve()
    saved = _link_record(Path(cfg_path).parent)
    if Path(cfg_path) != CFG and saved.is_file():
        return Path(saved.read_text().strip()).resolve()
    try:
        return Path(native.root_link('nvidia-prolapse')[1])
    except OSError as error:
        raise RuntimeError(f'{error}; or give the root explicitly')


def _cfg_rust_root(cfg):
    """The retired path key of a parsed cfg (nvidia_rust_driver_root, or nvidia_native_root of configurations
    from before nvidia_driver_mode): read-only use for old checkpoints (listing, hook decisions)."""
    if not cfg.has_section('waydroid'):
        return None
    return cfg['waydroid'].get('nvidia_rust_driver_root') or cfg['waydroid'].get('nvidia_native_root')


def _mode_root(mode):
    """Resolved root link of a native mode, or None when it is unusable."""
    try:
        return Path(native.root_link(mode)[1])
    except OSError:
        return None


def is_source_root(root):
    return (Path(root) / MANIFEST).exists()


def container_state():
    proc = subprocess.run(['lxc-info', *LXC_PATH, '-sH'], capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(f'lxc-info cannot read the Waydroid container ({proc.stderr.strip() or "no message"}). '
                           'Remedy: sudo waydroid upgrade -o (regenerates /var/lib/waydroid/lxc/waydroid/config for '
                           'this LXC), then re-run; if LXC still rejects the config, report this message')
    return proc.stdout.strip()


# ---------------------------------------------------------------- rendering (pure)

def render_override(root):
    """The container unit drop-in. One for every driver mode: `dev/driver-mode verify-active` validates
    whichever mode waydroid.cfg selects (for nvidia-prolapse it runs `check ROOT --active` on the configured
    root), so the drop-in no longer pins a root. `root` is kept for the callers' messages.

    [Unit]: the container starts after the NVIDIA render node's device unit (RENDER_UNIT, named by the package's
    70-waydroid-nvidia-gpu.rules), so at boot it waits for the GPU instead of racing the NVIDIA modules' init.
    Wants=, not Requires=: if the node never appears, systemd gives up after DefaultDeviceTimeoutSec and the
    ExecStartPre still runs, failing with the reason and the remedy (nvidia_native.ensure_gpu_ready)."""
    text = ('[Unit]\n'
            f'Wants={RENDER_UNIT}\n'
            f'After={RENDER_UNIT}\n'
            '\n'
            '[Service]\nExecStartPre=\n'
            f'ExecStartPre={PYTHON} {REPO}/dev/driver-mode verify-active\n')
    if PACKAGED:      # the unit's own ExecStart runs the packaged (patched) system Waydroid
        return text
    return text + ('ExecStart=\n'
                   f'ExecStart={PYTHON} {REPO}/build/waydroid/waydroid.py container start\n')


def render_hook(module_package):
    """The packaged hook's triggers, plus the package that provides the loaded kernel module.

    Exec runs `source-native hook`, which leaves a source deployment alone (the packaged
    setup would restage and repoint waydroid.cfg at the legacy root) and execs the legacy
    setup unchanged otherwise.
    """
    module_trigger = ''
    if module_package != 'nvidia-utils':
        module_trigger = ('[Trigger]\nOperation = Install\nOperation = Upgrade\nOperation = Remove\n'
                          f'Type = Package\nTarget = {module_package}\n\n')
    return (f'# Written by {REPO}/dev/source-native (activate / install-hook). It overrides\n'
            f'# {PACKAGED_HOOK} (same file name, alpm-hooks(5)).\n'
            '# For a source NVK + Rust RM root it does NOT run the legacy re-provisioning (that would\n'
            '# replace the deployment); it warns about the kernel-module pin instead. For any other\n'
            f'# root it runs {LEGACY_SETUP} --hook unchanged.\n'
            '# The last trigger is the package owning the NVIDIA kernel module, found at install time.\n'
            '[Trigger]\nOperation = Install\nOperation = Upgrade\nType = Package\nTarget = nvidia-utils\n\n'
            '[Trigger]\nOperation = Upgrade\nType = Package\nTarget = waydroid-nvidia-prolapse\n\n'
            f'{module_trigger}'
            '[Action]\nDescription = Checking Waydroid NVIDIA-native mode (source stack aware)...\n'
            'When = PostTransaction\n'
            f'Exec = {PYTHON} {REPO}/dev/source-native hook\n')


def hook_mode(cfg_path=CFG):
    """('source', root) | ('legacy', None) | ('unknown', reason). Only 'legacy' may run the
    packaged setup: when we cannot tell, re-provisioning could destroy a source deployment."""
    if not Path(cfg_path).exists():
        return 'legacy', None
    cfg = configparser.ConfigParser()
    try:
        cfg.read(cfg_path)
    except (OSError, configparser.Error) as error:
        return 'unknown', f'cannot parse {cfg_path}: {error}'
    mode = cfg['waydroid'].get('nvidia_driver_mode') if cfg.has_section('waydroid') else None
    if mode == 'nvidia-prolapse' and cfg['waydroid'].get('nvidia_prolapse_install') == 'vendor-image':
        return 'vendor-image', None
    if mode == 'nvidia-prolapse':
        root = _mode_root('nvidia-prolapse')
        return ('source', root) if root and is_source_root(root) else (
            'unknown', f'nvidia-prolapse mode, but {native.ROOT_LINKS["nvidia-prolapse"]} is not a usable source root link')
    if mode == 'venus':
        return 'venus', None
    if mode == 'glibc-shim':
        return 'glibc-shim', _mode_root('glibc-shim') or Path(native.ROOT_LINKS['glibc-shim'] + ' (unusable link)')
    if mode is not None:
        return 'unknown', f'{cfg_path} has unknown nvidia_driver_mode {mode!r}'
    root = cfg['waydroid'].get('nvidia_native_root') if cfg.has_section('waydroid') else None
    if mode is None and root and is_source_root(root):   # configuration from before nvidia_driver_mode
        return 'source', Path(root)
    return 'legacy', None


def source_mismatches(manifest):
    """Artifacts whose recorded source file no longer has the deployed bytes (adopt)."""
    sources = manifest.get('sources')
    if not isinstance(sources, dict):
        return ['manifest has no sources map']
    problems = []
    for relative, digest in sorted(manifest['artifacts'].items()):
        source = sources.get(relative)
        if not source:
            problems.append(f'{relative}: no source recorded')
            continue
        try:
            actual = sha256(source)
        except OSError as error:
            problems.append(f'{relative}: {source}: {error.strerror}')
            continue
        if actual != digest:
            problems.append(f'{relative}: {source} is {actual[:12]}, deployed {digest[:12]}')
    return problems


# ---------------------------------------------------------------- host facts

def module_package():
    """Package that provides the NVIDIA kernel module for the running kernel.

    A prebuilt module is owned directly; a DKMS build (updates/dkms/, owned by nobody) belongs
    to the package that installed its DKMS source tree (/var/lib/dkms/nvidia/<v>/source).
    """
    module = subprocess.check_output(['modinfo', '-n', 'nvidia'], text=True).strip()
    owner = subprocess.run(['pacman', '-Qqo', module], capture_output=True, text=True)
    if owner.returncode == 0:
        return owner.stdout.strip()
    if '/updates/dkms/' in module:
        version = subprocess.check_output(['modinfo', '-F', 'version', 'nvidia'], text=True).strip()
        source = os.path.realpath(f'/var/lib/dkms/nvidia/{version}/source')
        owner = subprocess.run(['pacman', '-Qqo', source], capture_output=True, text=True)
        if owner.returncode == 0:
            return owner.stdout.strip()
        raise RuntimeError(f'No package owns the DKMS source {source} of {module}: {owner.stderr.strip()}')
    raise RuntimeError(f'No package owns the NVIDIA kernel module {module}: {owner.stderr.strip()}')


def installed_module_version():
    return subprocess.check_output(['modinfo', '-F', 'version', 'nvidia'], text=True,
                                   stderr=subprocess.STDOUT).strip()


def process_start(pid):
    """Start time of a host process, seconds since the epoch (/proc/<pid>/stat field 22)."""
    stat = Path(f'/proc/{pid}/stat').read_text()
    ticks = int(stat.rsplit(')', 1)[1].split()[19])
    btime = next(int(l.split()[1]) for l in Path('/proc/stat').read_text().splitlines() if l.startswith('btime '))
    return btime + ticks / os.sysconf('SC_CLK_TCK')


