*.qpa

# build/: the Venus recipes below are tracked; every other build/<dir> is a scratch
# tree of the native stack (pinned clones, NDK, Mesa worktrees, outputs) and stays local.
# A new tracked recipe dir needs its own "!/build/<dir>/" line here.
/build/*
!/build/angle/
!/build/gralloc/
!/build/lineage-20/
!/build/mesa/
!/build/virglrenderer/
